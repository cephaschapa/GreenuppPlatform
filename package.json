{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cross-env NODE_ENV=development tsx watch --clear-screen=false server/index.ts",
    "dev:client": "vite --port 3000",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:analyze": "vite build --mode analyze",
    "start": "cross-env NODE_ENV=production PORT=5000 node dist/index.js",
    "start:debug": "cross-env NODE_ENV=production PORT=5000 DEBUG_APP=true node dist/index.js",
    "check": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo \"No tests specified\" && exit 0",
    "test:email": "tsx scripts/test-email.ts",
    "test:watch": "echo \"No tests specified\" && exit 0",
    "test:health": "node scripts/test-health-production.js",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist node_modules/.cache",
    "prebuild": "npm run clean",
    "generate-qr": "tsx scripts/generate-qr-codes.js",
    "regenerate-qr": "tsx scripts/regenerate-qr-codes.js",
    "optimize:db": "node scripts/optimize-performance.js",
    "optimize:indexes": "node scripts/performance-optimization.sql",
    "monitor:performance": "tsx scripts/monitor-performance.js",
    "build:mobile": "vite build && npx cap sync",
    "android:dev": "npx cap open android",
    "android:run": "npx cap run android",
    "android:sync": "npx cap sync android"
  },
