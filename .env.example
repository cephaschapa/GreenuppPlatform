# ==============================================
# GREENUPP ENVIRONMENT CONFIGURATION
# ==============================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# PostgreSQL database connection string
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://username:password@localhost:5432/greenupp

# Individual PostgreSQL connection parameters (used by some services)
PGHOST=localhost
PGPORT=5432
PGUSER=username
PGPASSWORD=password
PGDATABASE=greenupp

# ==============================================
# SESSION & SECURITY
# ==============================================
# Secret key for session encryption (generate a strong random string)
SESSION_SECRET=your-super-secret-session-key-minimum-32-characters

# Node environment (development/production)
NODE_ENV=development

# ==============================================
# AI SERVICES
# ==============================================
# OpenAI API key for AI farming assistant and crop predictions
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic Claude API key (alternative AI provider)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# ==============================================
# WEATHER SERVICES
# ==============================================
# Tomorrow.io API key (primary – better accuracy). Get from: https://app.tomorrow.io/development/keys
# If set, forecast uses Tomorrow.io; on failure falls back to OpenWeather.
TOMORROW_IO_API_KEY=your-tomorrow-io-api-key-here

# OpenWeatherMap API key (fallback when Tomorrow.io is not set or fails)
# Get from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweather-api-key-here

# ==============================================
# EMAIL SERVICES
# ==============================================
# SendGrid API key for email notifications and communications
# Get from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here

# ==============================================
# PAYMENT PROCESSING (STRIPE)
# ==============================================
# Stripe secret key for marketplace payments (server-side)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here

# Stripe publishable key for client-side (frontend)
# Get from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLIC_KEY=pk_test_your-stripe-publishable-key-here

# Stripe price ID for subscription plans (if using subscriptions)
# Get from: https://dashboard.stripe.com/products
STRIPE_PRICE_ID=price_your-stripe-price-id-here

# ==============================================
# CHAT & SOCIAL FEATURES (STREAM)
# ==============================================
# Stream Chat API key for social networking features
# Get from: https://getstream.io/chat/
STREAM_API_KEY=your-stream-api-key-here
STREAM_API_SECRET=your-stream-api-secret-here

# Stream Chat API key for frontend (client-side)
VITE_STREAM_API_KEY=your-stream-api-key-here

# ==============================================
# BLOCKCHAIN & TRACEABILITY
# ==============================================
# Hyperledger Fabric network configuration (if using blockchain)
FABRIC_NETWORK_URL=https://your-fabric-network-url
FABRIC_USER_CERT=path/to/user/certificate.pem
FABRIC_USER_KEY=path/to/user/private.key
FABRIC_CA_CERT=path/to/ca/certificate.pem

# ==============================================
# FILE STORAGE & UPLOADS
# ==============================================
# Cloudinary (recommended for marketplace & profile photos)
# Get from: https://cloudinary.com/console
# When set, marketplace listing images and upload API use Cloudinary.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# AWS S3 configuration (if using cloud storage)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# Local upload directory (relative to project root)
UPLOAD_DIR=uploads

# Maximum file size for uploads (in bytes)
MAX_FILE_SIZE=10485760

# ==============================================
# EXTERNAL APIS & INTEGRATIONS
# ==============================================
# Google Maps API key (for location services)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Twilio credentials (for SMS notifications)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ==============================================
# MONITORING & ANALYTICS
# ==============================================
# Sentry DSN for error tracking
SENTRY_DSN=https://your-sentry-dsn-here

# Google Analytics tracking ID
GA_TRACKING_ID=UA-your-tracking-id

# ==============================================
# REDIS (for caching and sessions)
# ==============================================
# Redis connection URL (if using Redis for caching/sessions)
REDIS_URL=redis://localhost:6379

# ==============================================
# DEVELOPMENT & DEBUGGING
# ==============================================
# Enable debug mode for additional logging
DEBUG=greenupp:*

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Port for the development server
PORT=5000

# Frontend development server port
VITE_PORT=3000

# ==============================================
# DOMAIN CONFIGURATION
# ==============================================
# Base domain for the application
BASE_DOMAIN=localhost

# Allowed domains for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://app.localhost:5000

# Cookie domain for sessions
COOKIE_DOMAIN=localhost

# ==============================================
# FEATURE FLAGS
# ==============================================
# Enable/disable specific features
ENABLE_BLOCKCHAIN=true
ENABLE_SOCIAL_FEATURES=true
ENABLE_MARKETPLACE=true
ENABLE_AI_ASSISTANT=true
ENABLE_WEATHER_INTEGRATION=true
ENABLE_PUSH_NOTIFICATIONS=true

# ==============================================
# RATE LIMITING
# ==============================================
# API rate limiting configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==============================================
# WEBHOOK ENDPOINTS
# ==============================================
# Stripe webhook endpoint secret (for payment processing)
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Other webhook secrets
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# ==============================================
# BACKUP & MAINTENANCE
# ==============================================
# Database backup location
BACKUP_DIR=backups

# Backup retention period (in days)
BACKUP_RETENTION_DAYS=30

# Maintenance mode flag
MAINTENANCE_MODE=false

# ==============================================
# SSL/TLS CONFIGURATION
# ==============================================
# SSL certificate paths (for production)
SSL_CERT_PATH=path/to/ssl/certificate.pem
SSL_KEY_PATH=path/to/ssl/private.key

# Force HTTPS redirect
FORCE_HTTPS=false

# ==============================================
# NOTES
# ==============================================
# 1. Replace all placeholder values with your actual API keys and configuration
# 2. Keep your .env file secure and never commit it to version control
# 3. Some services are optional - you can leave those blank if not using
# 4. For production, ensure all sensitive keys are properly secured
# 5. Regenerate SESSION_SECRET for production with a cryptographically secure random string
# 6. Test all integrations after setting up environment variables